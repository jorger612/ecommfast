# ══════════════════════════════════════════════════════
#  EcommFast — Variables de Entorno PRODUCCIÓN
#  Copia este archivo a .env.prod y rellena los valores
#  NUNCA subas .env.prod a Git
# ══════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_DB=ecommfast
POSTGRES_USER=ecommfast_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_FUERTE_123!

# ── Backend ──────────────────────────────────────────
NODE_ENV=production
PORT=3001

# La URL usa el nombre del servicio Docker "postgres" como host
DATABASE_URL=postgresql://ecommfast_user:CAMBIA_ESTO_POR_PASSWORD_FUERTE_123!@postgres:5432/ecommfast

# Mínimo 32 caracteres — genera uno con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_MIN_32_CARACTERES_ALEATORIO_AQUI
JWT_REFRESH_SECRET=CAMBIA_ESTO_OTRO_32_CARACTERES_ALEATORIO_AQUI

# URL del frontend en producción (sin barra final)
CORS_ORIGIN=https://tudominio.com

# ── Stripe (si lo usas) ──────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
