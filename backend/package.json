{
  "name": "ecommfast-backend",
  "version": "1.0.0",
  "description": "EcommFast API — Node.js + TypeScript + Express + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run health-check && tsx watch src/index.ts",
    "dev:fast": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npm run health-check && node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "setup-db": "bash src/scripts/setup-local-db.sh",
    "health-check": "tsx src/scripts/health-check.ts",
    "db:seed": "tsx seeds/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "stripe": "^15.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
